      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\n\n// Chỉ lưu cấu hình nếu công ty có kết nối kênh Facebook\nconst hasFb = Boolean(body.channel && body.channel.provider === 'facebook' && body.channel.access_token);\nif (!hasFb) {\n  return [];\n}\n\nreturn {\n  json: {\n    Company_Name: (body.company_name || '').trim(),\n    Fanpage_Name: body.channel?.name || 'Chưa kết nối',\n    Page_ID: String(body.channel?.page_id || ''),\n    Access_Token: body.channel?.access_token || '',\n    Sheet_Name: (body.company_name || '').trim(),\n    Status: 'Hoạt động'\n  }\n};"
      },
