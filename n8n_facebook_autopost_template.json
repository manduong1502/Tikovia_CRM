    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\n\n// CHỈ CÔNG TY ĐÃ KẾT NỐI KÊNH FACEBOOK MỚI GHI VÀO GOOGLE SHEET\nif (!body.is_facebook_autopost && !body.channel?.access_token) {\n  return []; // Bỏ qua, không ghi vào Google Sheet\n}\n\nlet mediaUrls = Array.isArray(body.media_urls) ? body.media_urls : (body.media_urls ? String(body.media_urls).split('\\n') : []);\nmediaUrls = mediaUrls.map(u => {\n  const trimmed = String(u || '').trim();\n  if (trimmed.includes('/uploads/')) {\n    const filename = trimmed.split('/uploads/')[1].split('?')[0];\n    return `https://prghikcgrgjsdowmnyzs.supabase.co/storage/v1/object/public/materials/${filename}`;\n  }\n  return trimmed;\n}).filter(Boolean);\n\nconst mediaUrlStr = mediaUrls.join('\\n');\n\nreturn {\n  json: {\n    Plan_ID: String(body.plan_id || ''),\n    Title: body.title || '',\n    Content: body.content || '',\n    Media_URLs: mediaUrlStr,\n    Scheduled_Time: body.scheduled_at || '',\n    Status: 'Chờ đăng',\n    Live_Post_URL: ''\n  }\n};"
      },
