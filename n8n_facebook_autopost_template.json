      "parameters": {
        "jsCode": "const fbResp = $input.item.json || {};\nlet post = {};\n\n// 1. Kiểm tra nếu đến từ luồng Album (Gộp Danh Sách ID Ảnh)\ntry {\n  post = $('Gộp Danh Sách ID Ảnh').item.json;\n} catch (e) {}\n\n// 2. Kiểm tra nếu đến từ Khóa Dòng (Đang xử lý)\nif (!post || !post.Plan_ID) {\n  try {\n    post = $('Khóa Dòng (Đang xử lý)').item.json;\n  } catch (e) {}\n}\n\n// 3. Fallback về Lọc Bài Đến Giờ & Ghép Token\nif (!post || !post.Plan_ID) {\n  try {\n    post = $('Lọc Bài Đến Giờ & Ghép Token').item.json;\n  } catch (e) {\n    post = $('Lọc Bài Đến Giờ & Ghép Token').first().json || {};\n  }\n}\n\nconst postId = fbResp.id || fbResp.post_id || '';\nconst liveUrl = postId ? `https://facebook.com/${postId}` : '';\n\nreturn {\n  json: {\n    Plan_ID: String(post.Plan_ID || ''),\n    Sheet_Name: post.Sheet_Name || 'Tikovia (Hệ thống)',\n    Status: 'Đã đăng',\n    Live_Post_URL: liveUrl,\n    post_id: postId,\n    live_post_url: liveUrl\n  }\n};"
