          }
        ],
        [
          {
            "node": "Lưu Trữ Đăng Thủ Công",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quét Lịch Hẹn (Mỗi 5 phút)": {
      "main": [
        [
          {
            "node": "Lọc Bài Đến Giờ Đăng",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lọc Bài Đến Giờ Đăng": {
      "main": [
        [
          {
            "node": "Đã Đến Giờ Hẹn?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Đã Đến Giờ Hẹn?": {
      "main": [
        [
          {
            "node": "Khóa Dòng (Đang xử lý)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
