      "name": "Tải Ảnh Chưa Đăng (FB Graph API)"
    },
    {
      "parameters": {
        "jsCode": "const photoResponses = $input.all().map(i => i.json);\nconst inputPhotos = $('Tách Từng Ảnh').all().map(i => i.json);\n\n// Gom các ID ảnh đã tải lên theo từng Plan_ID\nconst groups = {};\nfor (let i = 0; i < inputPhotos.length; i++) {\n  const meta = inputPhotos[i];\n  const resp = photoResponses[i] || {};\n  const planId = String(meta.Plan_ID || 'default');\n\n  if (!groups[planId]) {\n    groups[planId] = {\n      Page_ID: meta.Page_ID,\n      Access_Token: meta.Access_Token,\n      Content: meta.Content,\n      Plan_ID: meta.Plan_ID,\n      Sheet_Name: meta.Sheet_Name,\n      photoIds: []\n    };\n  }\n\n  if (resp.id) {\n    groups[planId].photoIds.push({ media_fbid: String(resp.id) });\n  }\n}\n\nreturn Object.values(groups).map(g => ({\n  json: {\n    Page_ID: g.Page_ID,\n    Access_Token: g.Access_Token,\n    Content: g.Content,\n    Plan_ID: g.Plan_ID,\n    Sheet_Name: g.Sheet_Name,\n    attached_media: JSON.stringify(g.photoIds)\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
