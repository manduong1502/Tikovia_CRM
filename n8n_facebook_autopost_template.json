    {
      "parameters": {
        "jsCode": "// Gộp thông tin công ty và chuẩn hóa thời gian hẹn + phân loại media (video, album ảnh, 1 ảnh, text)\nconst companies = $('Lọc Cty Đang Hoạt Động').all().map(i => i.json);\nconst postItems = $input.all();\n\nconst results = [];\nconst now = Date.now();\n\nfor (let i = 0; i < postItems.length; i++) {\n  const item = postItems[i];\n  const post = item.json;\n\n  // 1. Chỉ lấy bài có Status = 'Chờ đăng'\n  if (String(post.Status || '').trim() !== 'Chờ đăng') {\n    continue;\n  }\n\n  // 2. Ghép công ty tương ứng\n  const companyIndex = item.pairedItem?.item;\n  const company = (companyIndex !== undefined ? companies[companyIndex] : null)\n    || companies.find(c => c.Sheet_Name === post.Sheet_Name)\n    || companies[0]\n    || {};\n\n  if (!company.Page_ID || !company.Access_Token) {\n    continue;\n  }\n\n  // 3. Kiểm tra thời gian hẹn (chuẩn hóa múi giờ Việt Nam +07:00)\n  const schedStr = String(post.Scheduled_Time || '').trim();\n  if (!schedStr) continue;\n\n  const isoStr = schedStr.includes('+') ? schedStr : (schedStr.replace(' ', 'T') + '+07:00');\n  const schedTime = new Date(isoStr).getTime();\n\n  // 4. Chỉ giữ bài đã đến hoặc qua giờ hẹn (schedTime <= now)\n  if (!isNaN(schedTime) && schedTime <= now) {\n    const rawMedia = String(post.Media_URLs || '');\n    const lines = rawMedia\n      .split('\\n')\n      .map(l => l.replace(/^FILE:/i, '').trim())\n      .filter(l => l.startsWith('http'));\n\n    // Chuyển link local uploads sang Supabase CDN nếu có\n    const cleanedMediaUrls = lines.map(url => {\n      if (url.includes('/uploads/')) {\n        const filename = url.split('/uploads/')[1].split('?')[0];\n        return `https://prghikcgrgjsdowmnyzs.supabase.co/storage/v1/object/public/materials/${filename}`;\n      }\n      return url;\n    });\n\n    const isVideo = Boolean(cleanedMediaUrls.some(u => /\\.(mp4|mov|webm|avi|mkv|wmv|flv)(\\?|$)/i.test(u)) || String(post.Title || '').toLowerCase().includes('video'));\n    \n    let mediaType = 'text';\n    if (isVideo) {\n      mediaType = 'video';\n    } else if (cleanedMediaUrls.length > 1) {\n      mediaType = 'multi_image';\n    } else if (cleanedMediaUrls.length === 1) {\n      mediaType = 'image';\n    }\n\n    results.push({\n      json: {\n        ...post,\n        Company_Name: company.Company_Name || '',\n        Fanpage_Name: company.Fanpage_Name || '',\n        Page_ID: String(company.Page_ID || ''),\n        Access_Token: company.Access_Token || '',\n        Sheet_Name: company.Sheet_Name || 'Tikovia (Hệ thống)',\n        media_url: cleanedMediaUrls[0] || '',\n        photo_url: cleanedMediaUrls[0] || '',\n        video_url: cleanedMediaUrls[0] || '',\n        photo_urls: cleanedMediaUrls,\n        media_type: mediaType,\n        has_media: cleanedMediaUrls.length > 0,\n        Status: 'Đang xử lý'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
