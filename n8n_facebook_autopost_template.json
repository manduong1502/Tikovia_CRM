{
  "name": "Tikovia CRM - Facebook Auto-Post Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tikovia-post-approved",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook Tikovia CRM Duyệt Bài"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-fb",
              "leftValue": "={{ $json.body.is_facebook_autopost }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "id": "if-is-facebook",
      "name": "Có Kênh Facebook Fanpage?"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Posts"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Plan_ID": "={{ $json.body.plan_id }}",
            "Company_Name": "={{ $json.body.company_name }}",
            "Fanpage_Name": "={{ $json.body.channel?.name || 'N/A' }}",
            "Page_ID": "={{ $json.body.channel?.page_id || '' }}",
            "Title": "={{ $json.body.title }}",
            "Content": "={{ $json.body.content }}",
            "Media_URLs": "={{ $json.body.media_urls.join('\\n') }}",
            "Scheduled_Time": "={{ $json.body.scheduled_at }}",
            "Status": "Chờ đăng"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        200
      ],
      "id": "gsheet-append-queue",
      "name": "Lưu Hàng Đợi Chờ Đăng"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Posts"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Plan_ID": "={{ $json.body.plan_id }}",
            "Company_Name": "={{ $json.body.company_name }}",
            "Fanpage_Name": "N/A",
            "Page_ID": "",
            "Title": "={{ $json.body.title }}",
            "Content": "={{ $json.body.content }}",
            "Media_URLs": "={{ $json.body.media_urls.join('\\n') }}",
            "Scheduled_Time": "={{ $json.body.scheduled_at }}",
            "Status": "Đăng thủ công"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        400
      ],
      "id": "gsheet-append-manual",
      "name": "Lưu Trữ Đăng Thủ Công"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        650
      ],
      "id": "schedule-checker",
      "name": "Quét Lịch Hẹn (Mỗi 5 phút)"
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Posts"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Status",
              "lookupValue": "Chờ đăng"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        460,
        650
      ],
      "id": "gsheet-read-pending",
      "name": "Lọc Bài Đến Giờ Đăng"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-time",
              "leftValue": "={{ new Date($json.Scheduled_Time).getTime() }}",
              "rightValue": "={{ new Date().getTime() }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        650
      ],
      "id": "if-time-arrived",
      "name": "Đã Đến Giờ Hẹn?"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Posts"
        },
        "matchingColumn": "Plan_ID",
        "matchingValue": "={{ $json.Plan_ID }}",
        "fieldsUi": {
          "values": [
            {
              "column": "Status",
              "fieldValue": "Đang xử lý"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        630
      ],
      "id": "lock-row",
      "name": "Khóa Dòng (Đang xử lý)"
    }
  ],
  "connections": {
    "Webhook Tikovia CRM Duyệt Bài": {
      "main": [
        [
          {
            "node": "Có Kênh Facebook Fanpage?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Có Kênh Facebook Fanpage?": {
      "main": [
        [
          {
            "node": "Lưu Hàng Đợi Chờ Đăng",
            "type": "main",
